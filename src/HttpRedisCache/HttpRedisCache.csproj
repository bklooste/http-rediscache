<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<InvariantGlobalization>true</InvariantGlobalization>
		<AssemblyName>HttpRedisCache</AssemblyName>
		<RootNamespace>HttpRedisCache</RootNamespace>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="HttpRedisCache.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
		<PackageReference Include="StackExchange.Redis" Version="2.10.1" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.0" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.19.0-beta.1" />
	</ItemGroup>

</Project>
